# Configurazione della devbox LSE Terminal (opzionale).
# Tutto ha un default: `make up` funziona SENZA questo file.
# Copia in docker/.env per personalizzare:  cp docker/.env.example docker/.env

# ── App ──────────────────────────────────────────────────────────────────────
# Porta del terminale (lset). Con network_mode: host la porta e' quella
# dell'host: http://localhost:APP_PORT
APP_PORT=7787

# Interfaccia su cui lset resta in ascolto. Default 127.0.0.1 (loopback):
# l'engine porta la API key LSE, non esporsi oltre la macchina e' voluto.
# Cambialo solo se sai cosa stai facendo (es. accesso remoto via tunnel).
APP_HOST=127.0.0.1
